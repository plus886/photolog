# microCMS の認証情報
# microCMS 管理画面 → サービス設定 / API キー から取得
# このファイルを `.env` にコピーして実際の値を入力してください:
#   cp .env.example .env

# サービス ID（https://<ここ>.microcms.io の部分）
MICROCMS_DOMAIN=

# API キー（サイト配信用。GET 権限のみで足ります）
MICROCMS_API_KEY=

# --- ここから下は scripts/generate-alt.ts（alt 生成）用 ---
# サイト配信では使いません。ローカル実行時のみ必要です。

# PATCH 権限を付けた microCMS API キー。
# 配信用キーに書き込み権限を付けず、別キーに分けておくためのもの。
MICROCMS_WRITE_API_KEY=

# Claude API キー（https://console.anthropic.com/ で発行）
ANTHROPIC_API_KEY=
