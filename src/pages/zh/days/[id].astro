---
export const prerender = false;

import { loadDayPage } from "libs/dayPage";
import { SSR_CACHE_CONTROL } from "libs/cache";
import DayPage from "components/DayPage.astro";

const data = await loadDayPage(Astro.params.id);
if (!data) return new Response(null, { status: 404, statusText: "Not Found" });

Astro.response.headers.set("Cache-Control", SSR_CACHE_CONTROL);
---

<DayPage data={data} />
