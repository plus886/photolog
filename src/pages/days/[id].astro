---
export const prerender = false;

import dayjs from "libs/dayjs";
import Layout from "layouts/Layout.astro";
import Day from "components/Day";
import { getAdjacentDays, getDayDetail } from "libs/client";
import { SSR_CACHE_CONTROL } from "libs/cache";

const { id } = Astro.params;
if (!id) return new Response(null, { status: 404, statusText: "Not Found" });

const item = await getDayDetail(id).catch(() => null);
if (!item) return new Response(null, { status: 404, statusText: "Not Found" });

const { nextPost, prevPost } = await getAdjacentDays(item.date);

Astro.response.headers.set("Cache-Control", SSR_CACHE_CONTROL);
---

<Layout
  title={`翳光臺灣 | ${dayjs.tz(dayjs(item.date)).format("YYYY年M月D日")}`}
  thumbnail={item.image.url}
>
  <section
    class="grid h-[90dvh] grid-rows-[10dvh_1fr_25dvh] items-center justify-center md:h-dvh md:grid-cols-[1fr_3fr_2fr] md:grid-rows-1"
  >
    <Day item={item} nextPost={nextPost} prevPost={prevPost} client:load />
  </section>
</Layout>
