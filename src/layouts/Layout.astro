---
import "../styles/global.css";
import "lenis/dist/lenis.css";
import { ClientRouter } from "astro:transitions";
import Header from "components/Header";
import "@fontsource/shippori-mincho-b1";
import "@fontsource/cactus-classical-serif";
import "@fontsource/hina-mincho";
import { getAbsoluteLocaleUrl } from "astro:i18n";
import { resolveLocale, useTranslations } from "i18n/utils";

export interface Props {
  title?: string;
  description?: string;
  thumbnail?: string;
}

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const htmlLang = locale === "zh" ? "zh-Hant" : "ja";

// The same page in each locale, for the hreflang alternates.
const pathNoLocale = Astro.url.pathname.replace(/^\/zh(?=\/|$)/, "") || "/";
const jaHref = getAbsoluteLocaleUrl("ja", pathNoLocale);
const zhHref = getAbsoluteLocaleUrl("zh", pathNoLocale);

const {
  title = "翳光臺灣 | Formosa Chiaroscuro",
  description = t("meta.description"),
  thumbnail,
}: Props = Astro.props;

// Detail pages pass a photo; every other page uses the static OGP card.
const ogImage = thumbnail
  ? `${thumbnail}?w=1200&h=630&fit=crop`
  : new URL("/og-image.png", Astro.site).href;
---

<!doctype html>
<html lang={htmlLang} class="no-transition" style="color-scheme: light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="author" content="康凱爾" />
    <meta property="og:title" content={title} />
    <meta property="og:type" content="website" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={Astro.request.url} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@plus886" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="alternate" hreflang="ja" href={jaHref} />
    <link rel="alternate" hreflang="zh-Hant" href={zhHref} />
    <link rel="alternate" hreflang="x-default" href={jaHref} />
    <title>{title}</title>
    <script is:inline>
      (() => {
        // Theme first — before the locale check below. A mismatched
        // locale triggers a redirect, but the source page can still
        // paint during it, so it must already carry the right theme.
        const isDark = localStorage.getItem("theme") === "dark";
        document.documentElement.classList.toggle("dark", isDark);
        document.documentElement.style.colorScheme = isDark ? "dark" : "light";

        // Explicit /zh/ URLs are shown as-is so shared links keep their
        // language. Only the prefix-less default URLs auto-route to the
        // visitor's preferred locale — a saved choice, else the browser
        // language.
        const path = location.pathname;
        if (!/^\/zh(?=\/|$)/.test(path)) {
          const saved = localStorage.getItem("locale");
          const preferred =
            saved === "ja" || saved === "zh"
              ? saved
              : (navigator.language || "").toLowerCase().startsWith("zh")
                ? "zh"
                : "ja";
          if (preferred === "zh") {
            location.replace("/zh" + path + location.search + location.hash);
          }
        }
      })();
    </script>
    <ClientRouter />
  </head>
  <body
    class="bg-white text-zinc-800 transition-colors delay-150 duration-500 dark:bg-inky dark:text-pale"
  >
    <div
      id="layout"
      class="h-dvh transition-[grid] delay-150 duration-500 ease-in-out md:grid md:grid-cols-[1fr_5fr]"
    >
      <Header />
      <!-- overflow-anchor:none — scroll anchoring miscalculates when the
           gallery grid reflows on image load / pagination, yanking the
           scroll position. -->
      <div id="scroll-container" class="overflow-auto [overflow-anchor:none]">
        <div id="scroll-content">
          <slot />
        </div>
      </div>
    </div>
  </body>
</html>

<script>
  import Lenis from "lenis";
  import { isDrawerOpen, theme, lenisStore } from "libs/stores";

  const applyTheme = (v: string) => {
    const dark = v === "dark";
    document.documentElement.classList.toggle("dark", dark);
    document.documentElement.style.colorScheme = dark ? "dark" : "light";
  };

  // Apply the theme on user toggles. A view-transition swap copies the
  // incoming SSR <html> (which has no `.dark`), so also set it on that
  // document *before* the swap — otherwise the new page paints light
  // for a frame and the colour transition visibly flickers it dark.
  theme.subscribe(applyTheme);
  document.addEventListener("astro:before-swap", (event) => {
    const dark = theme.get() === "dark";
    const root = event.newDocument.documentElement;
    root.classList.toggle("dark", dark);
    root.style.colorScheme = dark ? "dark" : "light";
  });

  // #layout is recreated on each navigation; query it fresh inside the
  // callback so a single subscription always targets the current element.
  isDrawerOpen.subscribe((open) => {
    const el = document.getElementById("layout");
    el?.classList.toggle("md:grid-cols-[1fr_1fr]", open);
    el?.classList.toggle("md:grid-cols-[1fr_5fr]", !open);
    el?.classList.toggle("overflow-hidden", open);
    el?.classList.toggle("md:overflow-auto", open);
  });

  // The scroll container is recreated on each navigation, so re-create
  // Lenis each time. On mobile the container does not overflow (the
  // document scrolls), so Lenis sits inert and native touch scroll wins.
  let lenis: Lenis | undefined;
  document.addEventListener("astro:page-load", () => {
    if (isDrawerOpen.get()) isDrawerOpen.set(false);
    // The page has settled — re-enable transitions (suppressed during
    // load so the colour transition doesn't fire as the CSS applies).
    document.documentElement.classList.remove("no-transition");

    lenis?.destroy();
    const wrapper = document.getElementById("scroll-container");
    const content = document.getElementById("scroll-content");
    lenis =
      wrapper && content
        ? new Lenis({ wrapper, content, autoRaf: true })
        : undefined;
    lenisStore.set(lenis ?? null);
  });
</script>
