---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Header from "components/Header";
import "@fontsource/shippori-mincho-b1";
import "@fontsource/cactus-classical-serif";
import { getDays } from "libs/client";

export interface Props {
  title?: string;
  description?: string;
  thumbnail?: string;
}

const response = await getDays({ limit: 1 });
const latestItem = response.contents[0];

const {
  title = "翳光臺灣 | Formosa Chiaroscuro",
  description = "台湾で生きる日本人が一日一枚写真を投稿するフォトログ",
  thumbnail = latestItem.image.url,
}: Props = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="author" content="康凱爾" />
    <meta property="og:title" content={title} />
    <meta property="og:type" content="website" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${thumbnail}?w=1200&h=630&fit=crop`} />
    <meta property="og:url" content={Astro.request.url} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@plus886" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap.xml" />
    <title>{title}</title>
    <script is:inline>
      const lastTheme = localStorage.getItem("theme");
      document.documentElement.classList.toggle("dark", lastTheme === "dark");
    </script>
    <ClientRouter />
  </head>
  <body
    class="dark:bg-inky dark:text-pale transition-color text-zinc-800 delay-150 duration-500"
  >
    <div
      id="layout"
      class="h-dvh transition-[grid] delay-150 duration-500 ease-in-out md:grid md:grid-cols-[1fr_5fr]"
    >
      <Header />
      <!-- overflow-anchor:none — scroll anchoring miscalculates when the
           gallery grid reflows on image load / pagination, yanking the
           scroll position. -->
      <div class="overflow-auto scroll-smooth [overflow-anchor:none]">
        <slot />
      </div>
    </div>
  </body>
</html>

<script>
  import { isDrawerOpen, theme } from "libs/stores";

  const applyTheme = (v: string) =>
    document.documentElement.classList.toggle("dark", v === "dark");

  // View Transitions reset the <html> class on swap, so re-apply once
  // after each swap rather than re-subscribing (which would leak).
  theme.subscribe(applyTheme);
  document.addEventListener("astro:after-swap", () => applyTheme(theme.get()));

  // #layout is recreated on each navigation; query it fresh inside the
  // callback so a single subscription always targets the current element.
  isDrawerOpen.subscribe((open) => {
    const el = document.getElementById("layout");
    el?.classList.toggle("md:grid-cols-[1fr_1fr]", open);
    el?.classList.toggle("md:grid-cols-[1fr_5fr]", !open);
    el?.classList.toggle("overflow-hidden", open);
    el?.classList.toggle("md:overflow-auto", open);
  });

  document.addEventListener("astro:page-load", () => {
    if (isDrawerOpen.get()) isDrawerOpen.set(false);
  });
</script>
