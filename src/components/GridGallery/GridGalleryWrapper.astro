---
import GridGallery from "./GridGallery.svelte";
import { getAllDayIds, DEFAULT_LIMIT } from "libs/client";
import { resolveLocale } from "i18n/utils";

const res = await getAllDayIds();
const totalItemsLength = res.length;
const locale = resolveLocale(Astro.currentLocale);
const localePrefix = locale === "zh" ? "/zh" : "";
---

<GridGallery
  client:load
  {totalItemsLength}
  totalPages={Math.ceil(totalItemsLength / DEFAULT_LIMIT)}
  {localePrefix}
  {locale}
/>
