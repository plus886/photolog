---
import Layout from "layouts/Layout.astro";
import { resolveLocale, useTranslations } from "i18n/utils";
import { locationName } from "libs/location";
import type { LocationSummary } from "libs/client";

interface Props {
  summaries: LocationSummary[];
}

const { summaries } = Astro.props;

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const localePrefix = locale === "zh" ? "/zh" : "";
const title = `${t("locations.title")} | 翳光臺灣`;
---

<Layout title={title} description={t("locations.description")}>
  <section class="px-6 py-10 md:px-12">
    <header class="pb-8">
      <h1 class="font-serif text-2xl tracking-widest md:text-3xl">
        {t("locations.title")}
      </h1>
      <p class="pt-2 text-xs opacity-60">{t("locations.description")}</p>
    </header>

    <ul
      class="grid grid-cols-[repeat(auto-fill,minmax(8rem,1fr))] gap-2 md:grid-cols-[repeat(auto-fill,minmax(11rem,1fr))]"
    >
      {
        summaries.map(({ location, count, cover }) => (
          <li>
            <a
              href={`${localePrefix}/locations/${location.id}`}
              class="block no-underline"
            >
              <img
                src={`${cover.url}?w=340&h=230&fit=crop&q=60`}
                alt=""
                width="340"
                height="230"
                loading="lazy"
                class="h-full w-full object-cover transition-opacity hover:opacity-80"
              />
              <span class="flex items-baseline justify-between pt-1 text-xs">
                <span>{locationName(location, locale) ?? location.id}</span>
                <span class="opacity-50">
                  {count}
                  {t("locations.count")}
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
