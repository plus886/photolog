---
import Layout from "layouts/Layout.astro";
import { resolveLocale, useTranslations } from "i18n/utils";
import { locationName, locationPlace } from "libs/location";
import type { Location, DayCard } from "libs/client";

interface Props {
  location: Location;
  days: DayCard[];
}

const { location, days } = Astro.props;

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const localePrefix = locale === "zh" ? "/zh" : "";

const name = locationName(location, locale) ?? location.id;
const city = locale === "zh" ? location.cityZh : location.cityJa;
const heading = `${name}${t("locations.photosAt")}`;
const title = `${heading} | 翳光臺灣`;
const description = `${name}${
  city && city !== name ? `（${city}）` : ""
}で撮影した写真 ${days.length}${t("locations.count")}。`;

// The point of this page: a place, and every photo of it. CollectionPage +
// ImageObject lets search engines read it as exactly that rather than
// guessing from a grid of links.
const place = locationPlace(location, locale);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: heading,
  ...(place ? { about: place } : {}),
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: days.length,
    itemListElement: days.map((day, i) => ({
      "@type": "ListItem",
      position: i + 1,
      item: {
        "@type": "ImageObject",
        contentUrl: `${day.image.url}?w=1024`,
        ...((locale === "zh" ? day.altZh : day.altJa)
          ? { description: locale === "zh" ? day.altZh : day.altJa }
          : {}),
        ...(place ? { contentLocation: place } : {}),
      },
    })),
  },
};
const jsonLdHtml = JSON.stringify(jsonLd).replace(/</g, "\\u003c");
---

<Layout title={title} description={description} thumbnail={days[0]?.image.url}>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={jsonLdHtml}
  />
  <section class="px-6 py-10 md:px-12">
    <header class="pb-8">
      <h1 class="font-serif text-2xl tracking-widest md:text-3xl">
        {name}
      </h1>
      <p class="pt-2 text-xs opacity-60">
        {city && city !== name ? `${city} · ` : ""}{days.length}{
          t("locations.count")
        }
      </p>
    </header>

    <!-- Server-rendered, unlike the home grid: this page exists to be
         crawled, so the photos have to be in the HTML. -->
    <ul
      class="grid grid-cols-[repeat(auto-fill,minmax(8rem,1fr))] gap-2 md:grid-cols-[repeat(auto-fill,minmax(11rem,1fr))]"
    >
      {
        days.map((day) => (
          <li>
            <a href={`${localePrefix}/days/${day.id}`} class="block">
              <img
                src={`${day.image.url}?w=340&h=230&fit=crop&q=60`}
                alt={
                  (locale === "zh" ? day.altZh : day.altJa) ||
                  (day.date ?? day.publishedAt)?.slice(0, 10) ||
                  ""
                }
                width="340"
                height="230"
                loading="lazy"
                class="h-full w-full object-cover transition-opacity hover:opacity-80"
              />
            </a>
          </li>
        ))
      }
    </ul>

    <p class="pt-10 text-xs">
      <a href={`${localePrefix}/locations`}>{t("locations.title")}</a>
    </p>
  </section>
</Layout>
