---
import Layout from "layouts/Layout.astro";
import Thumbnail from "components/GridGallery/Thumbnail.svelte";
import { resolveLocale, useTranslations } from "i18n/utils";
import { locationName, locationPlace } from "libs/location";
import type { Location, DayCard } from "libs/client";

interface Props {
  location: Location;
  days: DayCard[];
}

const { location, days } = Astro.props;

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const localePrefix = locale === "zh" ? "/zh" : "";

const name = locationName(location, locale) ?? location.id;
const city = locale === "zh" ? location.cityZh : location.cityJa;
const heading = `${name}${t("locations.photosAt")}`;
const title = `${heading} | 翳光臺灣`;
const description = `${name}${
  city && city !== name ? `（${city}）` : ""
}で撮影した写真 ${days.length}${t("locations.count")}。`;

// The point of this page: a place, and every photo of it. CollectionPage +
// ImageObject lets search engines read it as exactly that rather than
// guessing from a grid of links.
const place = locationPlace(location, locale);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: heading,
  ...(place ? { about: place } : {}),
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: days.length,
    itemListElement: days.map((day, i) => ({
      "@type": "ListItem",
      position: i + 1,
      item: {
        "@type": "ImageObject",
        contentUrl: `${day.image.url}?w=1024`,
        ...((locale === "zh" ? day.altZh : day.altJa)
          ? { description: locale === "zh" ? day.altZh : day.altJa }
          : {}),
        ...(place ? { contentLocation: place } : {}),
      },
    })),
  },
};
const jsonLdHtml = JSON.stringify(jsonLd).replace(/</g, "\\u003c");
---

<Layout title={title} description={description} thumbnail={days[0]?.image.url}>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={jsonLdHtml}
  />

  <!-- Same grid as the home page, and Thumbnail renders without a client
       directive: this page exists to be crawled, so the photos and their
       alt text have to be in the HTML. The links work without hydration,
       and Astro hover-prefetches them anyway. -->
  <div class="grid grid-cols-7 lg:grid-cols-11">
    <!-- Shares the grid and the thumbnails' column span so the two right
         edges line up; the last glyph gets a negative margin to cancel the
         trailing letter-space that tracking leaves after it. -->
    <h1
      class="col-span-7 flex h-[16dvh] items-center justify-end pt-3 pb-2 font-serif text-xl tracking-[0.3em] md:h-[30dvh] md:text-lg lg:col-span-10"
    >
      <span class="pr-3 text-[0.6rem] opacity-40">
        {days.length}{t("locations.count")} /
      </span><span class="-mr-[0.3em]">{name}</span>
    </h1>
    <ul
      class="col-span-7 grid auto-rows-[4rem] grid-cols-[repeat(auto-fill,minmax(5rem,1fr))] gap-1 md:grid-cols-[repeat(auto-fill,minmax(6rem,1fr))] lg:col-span-10"
    >
      {
        days.map((day) => (
          <li>
            <Thumbnail {...day} {localePrefix} {locale} />
          </li>
        ))
      }
    </ul>
  </div>
</Layout>
