---
import dayjs from "libs/dayjs";
import Layout from "layouts/Layout.astro";
import Day from "components/Day";
import { resolveLocale } from "i18n/utils";
import type { DayPageData } from "libs/dayPage";

interface Props {
  data: DayPageData;
}

const { item, nextPost, prevPost } = Astro.props.data;

const locale = resolveLocale(Astro.currentLocale);
const localePrefix = locale === "zh" ? "/zh" : "";
const passage = locale === "zh" ? item.passageZh : item.passageJa;
const title = `翳光臺灣 | ${dayjs.tz(dayjs(item.date)).format("YYYY年M月D日")}`;
---

<Layout title={title} thumbnail={item.image.url}>
  <section
    class="grid h-[90dvh] grid-rows-[10dvh_1fr_25dvh] items-center justify-center md:h-dvh md:grid-cols-[1fr_3fr_2fr] md:grid-rows-1"
  >
    <Day
      item={item}
      nextPost={nextPost}
      prevPost={prevPost}
      localePrefix={localePrefix}
      passage={passage}
      client:load
    />
  </section>
</Layout>
