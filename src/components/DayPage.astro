---
import Layout from "layouts/Layout.astro";
import Day from "components/Day";
import { resolveLocale } from "i18n/utils";
import type { DayPageData } from "libs/dayPage";

interface Props {
  data: DayPageData;
}

const { item, nextPost, prevPost } = Astro.props.data;

const locale = resolveLocale(Astro.currentLocale);
const localePrefix = locale === "zh" ? "/zh" : "";
const passage = locale === "zh" ? item.passageZh : item.passageJa;
const title = `翳光臺灣 | ${item.id}`;
---

<Layout title={title} thumbnail={item.image.url}>
  <!-- Mobile: the passage row is `auto` so a long single-column tanka
       extends below the photo (the page grows tall) instead of
       overlapping it. The photo row keeps its prior 55dvh size. -->
  <section
    class="grid min-h-[90dvh] grid-rows-[10dvh_55dvh_auto] items-center justify-center md:h-dvh md:grid-cols-[1fr_3fr_2fr] md:grid-rows-1"
  >
    <Day
      item={item}
      nextPost={nextPost}
      prevPost={prevPost}
      localePrefix={localePrefix}
      locale={locale}
      passage={passage}
      client:load
    />
  </section>
</Layout>
