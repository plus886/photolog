---
import Layout from "layouts/Layout.astro";
import Day from "components/Day";
import { resolveLocale } from "i18n/utils";
import { locationName, locationPlace } from "libs/location";
import type { DayPageData } from "libs/dayPage";

interface Props {
  data: DayPageData;
}

const { item, nextPost, prevPost } = Astro.props.data;

const locale = resolveLocale(Astro.currentLocale);
const localePrefix = locale === "zh" ? "/zh" : "";
const passage = locale === "zh" ? item.passageZh : item.passageJa;

// Title leads with where and when, because that's what someone searches and
// because a truncated result should still show it — the site name goes last.
// `date` is when the photo was taken; publishedAt is a day or two later.
const place = locationName(item.location, locale);
const taken = (item.date ?? item.publishedAt)?.slice(0, 10);
const heading = [place, taken].filter(Boolean).join(" ");
const title = [heading, "翳光臺灣"].filter(Boolean).join(" | ");

// Dynamically-generated OG card (photo + dark mask + passage).
const ogImage = new URL(
  `/og/${item.id}.jpg${locale === "zh" ? "?lang=zh" : ""}`,
  Astro.site,
).href;

// ImageObject is what image search reads: it ties the file to its author,
// its description and where it was taken, none of which are recoverable
// from the markup alone. contentUrl points at the same resized file the
// page renders so the two aren't treated as separate images.
const alt = locale === "zh" ? item.altZh : item.altJa;
const contentLocation = locationPlace(item.location, locale);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ImageObject",
  contentUrl: `${item.image.url}?w=1024`,
  thumbnailUrl: `${item.image.url}?w=220&h=140&fit=crop`,
  ...(item.image.width ? { width: item.image.width } : {}),
  ...(item.image.height ? { height: item.image.height } : {}),
  name: title,
  ...(alt ? { description: alt } : {}),
  ...(passage ? { text: passage } : {}),
  ...((item.date ?? item.publishedAt)
    ? { datePublished: item.date ?? item.publishedAt }
    : {}),
  creator: { "@type": "Person", name: "康凱爾" },
  creditText: "康凱爾",
  copyrightNotice: "© 康凱爾",
  ...(contentLocation ? { contentLocation } : {}),
};
// `<` is escaped so a passage or alt containing "</script>" can't close the
// block early.
const jsonLdHtml = JSON.stringify(jsonLd).replace(/</g, "\\u003c");
---

<Layout
  title={title}
  thumbnail={item.image.url}
  ogImage={ogImage}
  description={passage || undefined}
>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={jsonLdHtml}
  />
  <!-- The page's heading, kept out of the layout: the design is a photo
       and its tanka, with nothing else to look at. Screen readers and
       crawlers still get a heading that says which place and day this is. -->
  {heading && <h1 class="sr-only">{heading}</h1>}
  <!-- Mobile stacks photo / passage / controls; the passage row is
       `auto` so a long single-column tanka just makes the page taller.
       Day.svelte's md:order-* restores the desktop column layout. -->
  <section
    class="grid min-h-[90dvh] grid-rows-[55dvh_auto_10dvh] items-center justify-center md:h-dvh md:grid-cols-[1fr_3fr_2fr] md:grid-rows-1"
  >
    <Day
      item={item}
      nextPost={nextPost}
      prevPost={prevPost}
      localePrefix={localePrefix}
      locale={locale}
      passage={passage}
      client:load
    />
  </section>
</Layout>
